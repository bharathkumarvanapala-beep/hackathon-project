# ==============================================================================
# Aarogya Drishti (ఆరోగ్య దృష్టి) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides:
#   cp .env.example .env
#
# IMPORTANT SECURITY REMINDER:
# - Never commit real patient information, live server secrets, or production passwords to Git.
# - In development, default values are provided so the application runs immediately without external setups.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration
# ------------------------------------------------------------------------------
# PORT: Local HTTP port the care server listens on (default: 4173)
PORT=4173

# HOST: Bind address. Keep 127.0.0.1 for local isolation.
HOST=127.0.0.1

# LAN_HOST: Optional private IPv4 (e.g. 192.168.1.10) to allow care-team tablets
# on the same Wi-Fi router to connect without internet. Must be a private IPv4.
# LAN_HOST=192.168.1.100
# LAN_PORT=4174

# COOKIE_SECURE: Set to true ONLY when deployed behind trusted HTTPS (e.g. Cloudflare or Caddy).
# In local development over HTTP, leave false so browser session cookies are accepted.
COOKIE_SECURE=false

# TRUST_CLOUDFLARE: Set to true if deployed behind a Cloudflare Tunnel so
# client IP addresses and HTTPS protocol headers are verified securely.
TRUST_CLOUDFLARE=false

# ------------------------------------------------------------------------------
# 2. Database & Storage Paths
# ------------------------------------------------------------------------------
# DATA_DIR: Directory where SQLite databases and storage folders reside.
# Default is .local (which is excluded from Git).
DATA_DIR=.local

# ------------------------------------------------------------------------------
# 3. AI & Image Analysis Configuration
# ------------------------------------------------------------------------------
# DRISHTI_AI_PYTHON: Path to the Python executable with PyTorch installed.
# Default searches for .local/ai-venv/Scripts/python.exe (Windows) or .local/ai-venv/bin/python (Linux).
# DRISHTI_AI_PYTHON=C:/Python312/python.exe

# AI_TIMEOUT_MS: Maximum time in milliseconds before terminating an AI inference job (default: 25000)
AI_TIMEOUT_MS=25000

# ------------------------------------------------------------------------------
# 4. Local Workflow Automation (n8n Integration)
# ------------------------------------------------------------------------------
# N8N_WEBHOOK_URL: Webhook destination for outbox care events.
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/drishti-events

# N8N_WEBHOOK_TOKEN: Shared secret header (X-Webhook-Token) sent by Aarogya Drishti to n8n.
# N8N_WEBHOOK_TOKEN=replace-with-a-random-secret

# N8N_CALLBACK_TOKEN: Shared secret header (X-Automation-Token) required by Aarogya Drishti
# when n8n posts receipts or meeting links back to the server.
# N8N_CALLBACK_TOKEN=replace-with-a-different-secret

# ------------------------------------------------------------------------------
# 5. Telephony Voice Intake (Bolna Provider)
# ------------------------------------------------------------------------------
# VOICE_CALLING_ENABLED: Enable only with approved budget and configured provider account.
VOICE_CALLING_ENABLED=false
# BOLNA_API_KEY=your-bolna-api-key
# BOLNA_AGENT_TE=your-telugu-agent-uuid
# BOLNA_AGENT_EN=your-english-agent-uuid
# Limit outgoing calls per day to protect clinic budget:
VOICE_DAILY_LIMIT=5
